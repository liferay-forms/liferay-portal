<%
Map<String, String> learnMessageLiferayObjects = ddlDisplayContext.getLearnMessage("general");

Map<String, String> learnMessageSince73 = ddlDisplayContext.getLearnMessage("general");
%>

<clay:alert
	displayType="warning"
>
	<liferay-ui:message arguments='<%= new String[] {StringBundler.concat("<a href=", StringPool.QUOTE, learnMessageSince73.get("url"), StringPool.QUOTE, " target=", StringPool.QUOTE, "_blank", StringPool.QUOTE, ">", learnMessageSince73.get("message"), "</a>"), StringBundler.concat("<a href=", StringPool.QUOTE, learnMessageLiferayObjects.get("url"), StringPool.QUOTE, " target=", StringPool.QUOTE, "_blank", StringPool.QUOTE, ">", learnMessageLiferayObjects.get("message"), "</a>")} %>' key="dynamic-data-lists-are-deprecated-x-and-will-be-discontinued-at-end-of-2024-please-move-your-data-to-x-by-then" translateArguments="<%= false %>" />
</clay:alert>